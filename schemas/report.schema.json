{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/security-agent-benchmark/report.schema.json",
  "title": "Canonical Security Assessment Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scan_summary", "attack_surface", "findings", "top_risks", "uncertainties", "next_steps", "overall_risk"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "scan_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_understanding", "scope_examined", "validation_performed", "limitations"],
      "properties": {
        "repository_understanding": { "type": "string", "minLength": 1 },
        "scope_examined": { "type": "array", "items": { "type": "string" } },
        "validation_performed": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "attack_surface": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "entry_points", "trust_boundary", "sensitive_operations"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "entry_points": { "type": "array", "items": { "type": "string" } },
          "trust_boundary": { "type": "string" },
          "sensitive_operations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    },
    "top_risks": { "type": "array", "items": { "type": "string" } },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "next_steps": { "type": "array", "items": { "type": "string" } },
    "overall_risk": { "enum": ["critical", "high", "medium", "low", "informational"] }
  },
  "definitions": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line", "symbol"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "commands", "observations"],
      "properties": {
        "status": { "enum": ["confirmed", "supported", "unverified"] },
        "commands": { "type": "array", "items": { "type": "string" } },
        "observations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "severity", "confidence", "cwe", "category", "locations", "entry_point", "source_to_sink", "preconditions", "exploitability", "impact", "evidence", "validation", "remediation", "regression_test", "uncertainty"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "cwe": { "type": "string" },
        "category": { "type": "string" },
        "locations": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/location" } },
        "entry_point": { "type": "string" },
        "source_to_sink": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "exploitability": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "validation": { "$ref": "#/definitions/validation" },
        "remediation": { "type": "string", "minLength": 1 },
        "regression_test": { "type": "string", "minLength": 1 },
        "uncertainty": { "type": "string" }
      }
    }
  }
}
